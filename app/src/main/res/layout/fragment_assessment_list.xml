<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="18dp"
        android:layout_marginRight="18dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/rounded_edittext">

        <EditText
            android:id="@+id/searchText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:hint="@string/search_text"
            android:paddingBottom="@dimen/half_side"
            android:paddingLeft="@dimen/card_margin"
            android:paddingRight="40dp"
            android:paddingTop="@dimen/half_side"
            android:singleLine="true"
            android:textColorHint="@color/colorCornFlowerBlue"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/searchIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/half_side"
            android:layout_alignParentEnd="true"
            android:layout_centerInParent="true"
            android:src="@drawable/ic_clear_black_24dp"
            android:contentDescription="@string/search_text" />

    </RelativeLayout>

    <TextView
        android:id="@+id/countStudents"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/half_side"
        android:layout_marginLeft="32dp"
        android:textSize="16sp"
        android:textColor="@color/colorCornFlowerBlue" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/assessmentRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/card_margin"
            android:padding="4dp"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/emptyView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/no_assessments_found"
            android:textColor="@color/colorCornFlowerBlue"
            android:textSize="16sp"
            android:visibility="gone" />

    </FrameLayout>
</LinearLayout>
